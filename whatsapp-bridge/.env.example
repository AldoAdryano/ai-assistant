WORKER_URL=https://your-worker.workers.dev
WHATSAPP_API_SECRET=ganti_dengan_secret_yang_sama_di_cloudflare
ALLOWED_WHATSAPP_NUMBER=628xxxxxxxxxx

# 1 = tanpa stiker (aman 2GB). 0 = full stiker.
LIGHT_MODE=1

# Hanya jika LIGHT_MODE=0
STICKER_CONCURRENCY=1
# 0 = foto saja (disarankan di HP). 1 = izinkan video stiker.
STICKER_VIDEO=0

# Opsional override path ffmpeg Termux
# FFMPEG_PATH=/data/data/com.termux/files/usr/bin/ffmpeg
